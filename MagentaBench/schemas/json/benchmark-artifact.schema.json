{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Content-addressed reference to an artifact stored outside the manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CustomBenchmarkArtifact": {
      "additionalProperties": false,
      "description": "Resolved form of a benchmark implemented by an external adapter.",
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Adapter",
          "type": "string"
        },
        "artifact_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "declaration_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "custom",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "artifact_digest",
        "declaration_ref",
        "id",
        "kind",
        "adapter"
      ],
      "title": "CustomBenchmarkArtifact",
      "type": "object"
    },
    "TaskSuiteBenchmarkArtifact": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Adapter",
          "type": "string"
        },
        "artifact_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "declaration_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "task_suite",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "artifact_digest",
        "declaration_ref",
        "id",
        "kind",
        "adapter"
      ],
      "title": "TaskSuiteBenchmarkArtifact",
      "type": "object"
    },
    "ToolAgentSuiteBenchmarkArtifact": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Adapter",
          "type": "string"
        },
        "artifact_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "declaration_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "input_contract": {
          "minLength": 1,
          "title": "Input Contract",
          "type": "string"
        },
        "kind": {
          "const": "tool_agent_suite",
          "title": "Kind",
          "type": "string"
        },
        "output_contract": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Output Contract",
          "type": "array"
        }
      },
      "required": [
        "artifact_digest",
        "declaration_ref",
        "id",
        "kind",
        "adapter",
        "input_contract",
        "output_contract"
      ],
      "title": "ToolAgentSuiteBenchmarkArtifact",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "custom": "#/$defs/CustomBenchmarkArtifact",
      "task_suite": "#/$defs/TaskSuiteBenchmarkArtifact",
      "tool_agent_suite": "#/$defs/ToolAgentSuiteBenchmarkArtifact"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TaskSuiteBenchmarkArtifact"
    },
    {
      "$ref": "#/$defs/ToolAgentSuiteBenchmarkArtifact"
    },
    {
      "$ref": "#/$defs/CustomBenchmarkArtifact"
    }
  ]
}
