{
  "$defs": {
    "CustomBenchmarkArtifact": {
      "additionalProperties": false,
      "description": "Resolved form of a benchmark implemented by an external adapter.",
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Adapter",
          "type": "string"
        },
        "artifact_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "authoritative_reward_metric": {
          "minLength": 1,
          "title": "Authoritative Reward Metric",
          "type": "string"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "commit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "content_globs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Content Globs",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "custom",
          "title": "Kind",
          "type": "string"
        },
        "reward_pass_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward Pass Value"
        },
        "scoring_kind": {
          "$ref": "#/$defs/ScoringKind"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_content_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Content Digest",
          "type": "string"
        },
        "verifier": {
          "minLength": 1,
          "title": "Verifier",
          "type": "string"
        }
      },
      "required": [
        "artifact_digest",
        "source",
        "source_content_digest",
        "id",
        "kind",
        "adapter",
        "content_globs",
        "verifier",
        "scoring_kind",
        "authoritative_reward_metric"
      ],
      "title": "CustomBenchmarkArtifact",
      "type": "object"
    },
    "ScoringKind": {
      "description": "Benchmark-owned verdict semantics.\n\nContinuous scoring supports metric/effect claims but not pass-rate claims;\ndownstream compilation must reject pass-rate estimands without a threshold.",
      "enum": [
        "binary",
        "continuous"
      ],
      "title": "ScoringKind",
      "type": "string"
    },
    "TaskSuiteBenchmarkArtifact": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Adapter",
          "type": "string"
        },
        "artifact_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "authoritative_reward_metric": {
          "minLength": 1,
          "title": "Authoritative Reward Metric",
          "type": "string"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "commit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "task_suite",
          "title": "Kind",
          "type": "string"
        },
        "reward_pass_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward Pass Value"
        },
        "scoring_kind": {
          "$ref": "#/$defs/ScoringKind"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_content_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Content Digest",
          "type": "string"
        },
        "task_manifest": {
          "minLength": 1,
          "title": "Task Manifest",
          "type": "string"
        },
        "verifier": {
          "minLength": 1,
          "title": "Verifier",
          "type": "string"
        }
      },
      "required": [
        "artifact_digest",
        "source",
        "source_content_digest",
        "id",
        "kind",
        "adapter",
        "task_manifest",
        "verifier",
        "scoring_kind",
        "authoritative_reward_metric"
      ],
      "title": "TaskSuiteBenchmarkArtifact",
      "type": "object"
    },
    "ToolAgentSuiteBenchmarkArtifact": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Adapter",
          "type": "string"
        },
        "artifact_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "authoritative_reward_metric": {
          "minLength": 1,
          "title": "Authoritative Reward Metric",
          "type": "string"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "commit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "evaluator": {
          "minLength": 1,
          "title": "Evaluator",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "input_contract": {
          "minLength": 1,
          "title": "Input Contract",
          "type": "string"
        },
        "kind": {
          "const": "tool_agent_suite",
          "title": "Kind",
          "type": "string"
        },
        "output_contract": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Output Contract",
          "type": "array"
        },
        "reward_pass_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward Pass Value"
        },
        "scoring_kind": {
          "$ref": "#/$defs/ScoringKind"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_content_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Content Digest",
          "type": "string"
        },
        "task_root": {
          "minLength": 1,
          "title": "Task Root",
          "type": "string"
        }
      },
      "required": [
        "artifact_digest",
        "source",
        "source_content_digest",
        "id",
        "kind",
        "adapter",
        "task_root",
        "input_contract",
        "output_contract",
        "evaluator",
        "scoring_kind",
        "authoritative_reward_metric"
      ],
      "title": "ToolAgentSuiteBenchmarkArtifact",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "custom": "#/$defs/CustomBenchmarkArtifact",
      "task_suite": "#/$defs/TaskSuiteBenchmarkArtifact",
      "tool_agent_suite": "#/$defs/ToolAgentSuiteBenchmarkArtifact"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TaskSuiteBenchmarkArtifact"
    },
    {
      "$ref": "#/$defs/ToolAgentSuiteBenchmarkArtifact"
    },
    {
      "$ref": "#/$defs/CustomBenchmarkArtifact"
    }
  ]
}
