{
  "$defs": {
    "CustomBenchmarkSpec": {
      "additionalProperties": false,
      "description": "Generic benchmark declaration owned by an external BMP adapter.",
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Adapter",
          "type": "string"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "custom",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "adapter"
      ],
      "title": "CustomBenchmarkSpec",
      "type": "object"
    },
    "TaskSuiteBenchmarkSpec": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Adapter",
          "type": "string"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "task_suite",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "adapter"
      ],
      "title": "TaskSuiteBenchmarkSpec",
      "type": "object"
    },
    "ToolAgentSuiteBenchmarkSpec": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Adapter",
          "type": "string"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "input_contract": {
          "minLength": 1,
          "title": "Input Contract",
          "type": "string"
        },
        "kind": {
          "const": "tool_agent_suite",
          "title": "Kind",
          "type": "string"
        },
        "output_contract": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Output Contract",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "adapter",
        "input_contract",
        "output_contract"
      ],
      "title": "ToolAgentSuiteBenchmarkSpec",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "custom": "#/$defs/CustomBenchmarkSpec",
      "task_suite": "#/$defs/TaskSuiteBenchmarkSpec",
      "tool_agent_suite": "#/$defs/ToolAgentSuiteBenchmarkSpec"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TaskSuiteBenchmarkSpec"
    },
    {
      "$ref": "#/$defs/ToolAgentSuiteBenchmarkSpec"
    },
    {
      "$ref": "#/$defs/CustomBenchmarkSpec"
    }
  ]
}
