{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Content-addressed reference to an artifact stored outside the manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "EvolutionArchiveEntry": {
      "additionalProperties": false,
      "description": "One candidate's immutable state in an archive snapshot.",
      "properties": {
        "candidate_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Candidate Id",
          "type": "string"
        },
        "candidate_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "child_count": {
          "default": 0,
          "minimum": 0,
          "title": "Child Count",
          "type": "integer"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "lineage_depth": {
          "default": 0,
          "minimum": 0,
          "title": "Lineage Depth",
          "type": "integer"
        },
        "parent_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "score_metric": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score Metric"
        },
        "status": {
          "enum": [
            "ineligible",
            "eligible",
            "retained",
            "promoted",
            "evicted"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "generation",
        "candidate_ref",
        "status"
      ],
      "title": "EvolutionArchiveEntry",
      "type": "object"
    },
    "EvolutionArchiveSnapshot": {
      "additionalProperties": false,
      "description": "A complete archive population at one transition boundary.",
      "properties": {
        "entries": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvolutionArchiveEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "evaluator_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evaluator Digest",
          "type": "string"
        },
        "format": {
          "const": "bmp-evolution-archive-snapshot-v1",
          "default": "bmp-evolution-archive-snapshot-v1",
          "title": "Format",
          "type": "string"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        }
      },
      "required": [
        "evaluator_digest",
        "metric",
        "policy_digest"
      ],
      "title": "EvolutionArchiveSnapshot",
      "type": "object"
    },
    "EvolutionArchiveTransition": {
      "additionalProperties": false,
      "description": "Hash-chained before/after archive state for one lifecycle transition.",
      "properties": {
        "after": {
          "$ref": "#/$defs/EvolutionArchiveSnapshot"
        },
        "after_archive_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "After Archive Digest",
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/EvolutionArchiveSnapshot"
        },
        "before_archive_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Before Archive Digest",
          "type": "string"
        },
        "candidate_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Candidate Ids",
          "type": "array"
        },
        "eligible_candidate_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Eligible Candidate Ids",
          "type": "array"
        },
        "phase": {
          "$ref": "#/$defs/EvolutionArchiveTransitionPhase"
        },
        "policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "previous_transition_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Transition Digest"
        },
        "promotion_gate_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promotion Gate Id"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "selected_candidate_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Candidate Id"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "transition_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Transition Id",
          "type": "string"
        }
      },
      "required": [
        "transition_id",
        "sequence",
        "phase",
        "before",
        "after",
        "before_archive_digest",
        "after_archive_digest",
        "policy_digest",
        "reason"
      ],
      "title": "EvolutionArchiveTransition",
      "type": "object"
    },
    "EvolutionArchiveTransitionPhase": {
      "description": "Lifecycle boundary represented by an archive transition.",
      "enum": [
        "seed",
        "generate",
        "staged_evaluation",
        "revise",
        "select",
        "promote",
        "terminate"
      ],
      "title": "EvolutionArchiveTransitionPhase",
      "type": "string"
    },
    "EvolutionSelectionPolicy": {
      "additionalProperties": false,
      "description": "Explicit, replayable policy for choosing a parent/candidate.\n\nThe runtime must receive this object from the experiment configuration (or\nuse the documented deterministic default).  Keeping the selector identity,\ndirection, tie break, and RNG state in the receipt prevents a later\nimplementation change from silently changing which candidate was chosen.",
      "properties": {
        "child_count_penalty": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Child Count Penalty",
          "type": "number"
        },
        "direction": {
          "enum": [
            "maximize",
            "minimize"
          ],
          "title": "Direction",
          "type": "string"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Policy Id",
          "type": "string"
        },
        "rng_algorithm": {
          "default": "none",
          "minLength": 1,
          "title": "Rng Algorithm",
          "type": "string"
        },
        "rng_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rng Seed"
        },
        "rng_state_after": {
          "default": "none",
          "minLength": 1,
          "title": "Rng State After",
          "type": "string"
        },
        "rng_state_before": {
          "default": "none",
          "minLength": 1,
          "title": "Rng State Before",
          "type": "string"
        },
        "selector": {
          "enum": [
            "extreme",
            "weighted"
          ],
          "title": "Selector",
          "type": "string"
        },
        "tie_break_rule": {
          "minLength": 1,
          "title": "Tie Break Rule",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "selector",
        "metric",
        "direction",
        "tie_break_rule"
      ],
      "title": "EvolutionSelectionPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete archive history; no state may be reconstructed from a snapshot.",
  "properties": {
    "evaluator_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluator Digest",
      "type": "string"
    },
    "final_archive_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Final Archive Digest",
      "type": "string"
    },
    "format": {
      "const": "bmp-evolution-archive-ledger-v1",
      "default": "bmp-evolution-archive-ledger-v1",
      "title": "Format",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/EvolutionSelectionPolicy"
    },
    "transitions": {
      "items": {
        "$ref": "#/$defs/EvolutionArchiveTransition"
      },
      "minItems": 1,
      "title": "Transitions",
      "type": "array"
    }
  },
  "required": [
    "policy",
    "evaluator_digest",
    "transitions",
    "final_archive_digest"
  ],
  "title": "EvolutionArchiveLedger",
  "type": "object"
}
