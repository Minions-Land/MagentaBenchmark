        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "sidecar_schema_version": {
          "default": "0.1",
          "minLength": 1,
          "title": "Sidecar Schema Version",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AssemblySidecarRef",
      "type": "object"
    },
    "AssemblySubjectArtifact": {
      "additionalProperties": false,
      "description": "Pinned harness whose assembly evidence remains opaque to BMP core.",
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Adapter",
          "type": "string"
        },
