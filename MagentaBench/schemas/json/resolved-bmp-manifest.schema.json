          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "assembly_profile": {
          "default": "default",
          "minLength": 1,
          "title": "Assembly Profile",
          "type": "string"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "commit": {
          "minLength": 1,
          "title": "Commit",
          "type": "string"
        },
        "emits_trace": {
          "default": false,
          "title": "Emits Trace",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "hcp_harness",
          "title": "Kind",
          "type": "string"
        },
        "sidecar_ref": {
          "anyOf": [
