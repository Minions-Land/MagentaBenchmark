{
  "$defs": {
    "AssemblySidecarRef": {
      "additionalProperties": false,
      "description": "Opaque reference to the assembly sidecar produced by ``magenta_hcp``.\n\nBMP records path and digest for provenance but does not interpret contents.",
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "sidecar_schema_version": {
          "default": "0.1",
          "minLength": 1,
          "title": "Sidecar Schema Version",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "AssemblySidecarRef",
      "type": "object"
    },
    "AssemblySubjectArtifact": {
      "additionalProperties": false,
      "description": "Pinned harness whose assembly evidence remains opaque to BMP core.",
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Adapter",
          "type": "string"
        },
        "artifact_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Digest",
          "type": "string"
        },
        "assembly_profile": {
          "default": "default",
          "minLength": 1,
          "title": "Assembly Profile",
          "type": "string"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "commit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "emits_trace": {
          "default": false,
          "title": "Emits Trace",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "hcp_harness",
          "title": "Kind",
          "type": "string"
        },
        "sidecar_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssemblySidecarRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_content_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Content Digest",
          "type": "string"
        }
      },
      "required": [
        "artifact_digest",
        "source",
        "source_content_digest",
        "id",
        "kind",
        "adapter"
      ],
      "title": "AssemblySubjectArtifact",
      "type": "object"
    },
