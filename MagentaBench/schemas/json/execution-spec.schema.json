{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "description": "Hard limits for a run; absent fields mean that limit is unspecified.",
      "properties": {
        "max_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_wall_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Seconds"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "CredentialRef": {
      "additionalProperties": false,
      "description": "Identity-bearing credential digest; secret values are never serialized.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "secret": {
          "const": true,
          "title": "Secret",
          "type": "boolean"
        },
        "source_file": {
          "minLength": 1,
          "title": "Source File",
          "type": "string"
        },
        "value_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value_sha256",
        "secret",
        "source_file"
      ],
      "title": "CredentialRef",
      "type": "object"
    },
    "ProviderBinding": {
      "additionalProperties": false,
      "description": "Resolved provider, transport, model, and credential identity.",
      "properties": {
        "base_url": {
          "minLength": 1,
          "title": "Base Url",
          "type": "string"
        },
        "credential_ref": {
          "$ref": "#/$defs/CredentialRef"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "provider_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Provider Id",
          "type": "string"
        },
        "wire_api": {
          "minLength": 1,
          "title": "Wire Api",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "base_url",
        "wire_api",
        "model_id",
        "credential_ref"
      ],
      "title": "ProviderBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "TOML execution declaration: registry references plus local overrides.",
  "properties": {
    "backend": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Backend",
      "type": "string"
    },
    "backend_overrides": {
      "additionalProperties": true,
      "title": "Backend Overrides",
      "type": "object"
    },
    "budget": {
      "anyOf": [
        {
          "$ref": "#/$defs/Budget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "provider_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    }
  },
  "required": [
    "backend",
    "model"
  ],
  "title": "ExecutionSpec",
  "type": "object"
}
