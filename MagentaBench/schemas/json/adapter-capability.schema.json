{
  "additionalProperties": false,
  "description": "Declarative capability contract for a pluggable BMP adapter.\n\nThe entrypoint is metadata only until a host explicitly registers the\nimplementation object.  This keeps a TOML declaration from silently\nselecting executable code while still making supported kinds and config\npaths inspectable and hashable.",
  "properties": {
    "adapter": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
      "title": "Adapter",
      "type": "string"
    },
    "adapter_kind": {
      "enum": [
        "benchmark_loader",
        "backend_factory",
        "execution",
        "metric_source"
      ],
      "title": "Adapter Kind",
      "type": "string"
    },
    "backend_default_read_set": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Backend Default Read Set"
    },
    "bmp_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Bmp Version",
      "type": "string"
    },
    "config_paths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Config Paths",
      "type": "array"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "entrypoint": {
      "minLength": 1,
      "title": "Entrypoint",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "adapter",
      "title": "Kind",
      "type": "string"
    },
    "metric_config_schema": {
      "additionalProperties": true,
      "title": "Metric Config Schema",
      "type": "object"
    },
    "metric_config_schema_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metric Config Schema Digest"
    },
    "model_activation_source": {
      "anyOf": [
        {
          "enum": [
            "provider_response",
            "runtime_manifest",
            "native_result",
            "adapter_receipt"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Activation Source"
    },
    "none_model_sentinels": {
      "default": [],
      "items": {
        "enum": [
          "none",
          "none/deterministic",
          "none/echo"
        ],
        "type": "string"
      },
      "title": "None Model Sentinels",
      "type": "array"
    },
    "source": {
      "default": ".",
      "title": "Source",
      "type": "string"
    },
    "supported_backend_adapters": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Supported Backend Adapters",
      "type": "array"
    },
    "supported_backend_kinds": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Supported Backend Kinds",
      "type": "array"
    },
    "supported_benchmark_kinds": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Supported Benchmark Kinds",
      "type": "array"
    },
    "supported_metric_formulas": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Supported Metric Formulas",
      "type": "array"
    },
    "supported_metric_sources": {
      "default": [],
      "items": {
        "enum": [
          "regime",
          "evolution",
          "external"
        ],
        "type": "string"
      },
      "title": "Supported Metric Sources",
      "type": "array"
    },
    "supported_state_reset_policies": {
      "default": [],
      "items": {
        "enum": [
          "per_case",
          "per_rollout",
          "never"
        ],
        "type": "string"
      },
      "title": "Supported State Reset Policies",
      "type": "array"
    },
    "supported_subject_adapters": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Supported Subject Adapters",
      "type": "array"
    },
    "supported_subject_interfaces": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Supported Subject Interfaces",
      "type": "array"
    },
    "supported_subject_kinds": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Supported Subject Kinds",
      "type": "array"
    }
  },
  "required": [
    "id",
    "kind",
    "adapter",
    "adapter_kind",
    "entrypoint",
    "digest"
  ],
  "title": "AdapterCapability",
  "type": "object"
}
