{
  "$defs": {
    "BudgetAllocation": {
      "additionalProperties": false,
      "description": "Pre-launch token/cost allocation; wall time remains global.",
      "properties": {
        "max_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        }
      },
      "title": "BudgetAllocation",
      "type": "object"
    },
    "EvolutionBudgetOperation": {
      "description": "Billable operations understood by the neutral runtime.",
      "enum": [
        "parent_evolution",
        "seed",
        "generate",
        "search_evaluate",
        "revise",
        "holdout_evaluate"
      ],
      "title": "EvolutionBudgetOperation",
      "type": "string"
    },
    "UsageRecord": {
      "additionalProperties": false,
      "properties": {
        "cache_read_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Read Tokens"
        },
        "cache_write_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Write Tokens"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        },
        "wall_clock_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Clock Seconds"
        }
      },
      "title": "UsageRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One measured operation debit and its root-budget lineage.",
  "properties": {
    "attributes": {
      "additionalProperties": true,
      "title": "Attributes",
      "type": "object"
    },
    "budget_exceeded": {
      "default": false,
      "title": "Budget Exceeded",
      "type": "boolean"
    },
    "candidate_ids": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Ids",
      "type": "array"
    },
    "event_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Event Id",
      "type": "string"
    },
    "operation": {
      "$ref": "#/$defs/EvolutionBudgetOperation"
    },
    "remaining_after": {
      "$ref": "#/$defs/BudgetAllocation"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "spent": {
      "$ref": "#/$defs/UsageRecord"
    },
    "usage_observable": {
      "title": "Usage Observable",
      "type": "boolean"
    }
  },
  "required": [
    "event_id",
    "sequence",
    "operation",
    "candidate_ids",
    "spent",
    "usage_observable",
    "remaining_after"
  ],
  "title": "EvolutionBudgetEvent",
  "type": "object"
}
