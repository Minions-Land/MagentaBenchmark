{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Content-addressed reference to an artifact stored outside the manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ContextCompactionStatus": {
      "enum": [
        "complete",
        "failed"
      ],
      "title": "ContextCompactionStatus",
      "type": "string"
    },
    "UsageRecord": {
      "additionalProperties": false,
      "properties": {
        "cache_read_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Read Tokens"
        },
        "cache_write_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Write Tokens"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        },
        "cpu_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Seconds"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "io_read_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Io Read Bytes"
        },
        "io_write_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Io Write Bytes"
        },
        "model_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Calls"
        },
        "network_egress_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network Egress Bytes"
        },
        "network_ingress_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network Ingress Bytes"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "peak_memory_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Memory Bytes"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        },
        "retries": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retries"
        },
        "tool_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        },
        "tool_errors": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Errors"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        },
        "wall_clock_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Clock Seconds"
        }
      },
      "title": "UsageRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One budgeted, replayable context transformation.\n\nThe uncompacted history remains independently authoritative; this receipt\nonly explains how one runtime context view was derived from it.",
  "properties": {
    "attempt_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Attempt Id",
      "type": "string"
    },
    "budget_event_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "dropped_message_ids": {
      "items": {
        "type": "string"
      },
      "title": "Dropped Message Ids",
      "type": "array"
    },
    "error_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error_type": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Type"
    },
    "finished_at": {
      "title": "Finished At",
      "type": "string"
    },
    "format": {
      "const": "bmp-context-compaction-receipt-v1",
      "default": "bmp-context-compaction-receipt-v1",
      "title": "Format",
      "type": "string"
    },
    "mode": {
      "enum": [
        "truncate",
        "summarize",
        "hybrid"
      ],
      "title": "Mode",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Operation Id",
      "type": "string"
    },
    "phase": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Phase",
      "type": "string"
    },
    "post_context_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Post Context Digest"
    },
    "post_message_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Post Message Count"
    },
    "post_token_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Post Token Count"
    },
    "pre_context_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pre Context Digest",
      "type": "string"
    },
    "pre_message_count": {
      "minimum": 0,
      "title": "Pre Message Count",
      "type": "integer"
    },
    "pre_message_ids": {
      "items": {
        "type": "string"
      },
      "title": "Pre Message Ids",
      "type": "array"
    },
    "pre_token_count": {
      "minimum": 0,
      "title": "Pre Token Count",
      "type": "integer"
    },
    "prompt_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "raw_history_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "retained_message_ids": {
      "items": {
        "type": "string"
      },
      "title": "Retained Message Ids",
      "type": "array"
    },
    "retries": {
      "minimum": 0,
      "title": "Retries",
      "type": "integer"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ContextCompactionStatus"
    },
    "strategy_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Strategy Digest",
      "type": "string"
    },
    "strategy_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Strategy Id",
      "type": "string"
    },
    "summarized_message_ids": {
      "items": {
        "type": "string"
      },
      "title": "Summarized Message Ids",
      "type": "array"
    },
    "summary_input_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "summary_model_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary Model Digest"
    },
    "summary_output_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trigger": {
      "enum": [
        "threshold",
        "emergency",
        "manual",
        "provider_limit"
      ],
      "title": "Trigger",
      "type": "string"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    },
    "usage": {
      "$ref": "#/$defs/UsageRecord"
    }
  },
  "required": [
    "attempt_id",
    "operation_id",
    "trigger",
    "phase",
    "mode",
    "strategy_id",
    "strategy_digest",
    "raw_history_ref",
    "pre_context_digest",
    "pre_message_ids",
    "retained_message_ids",
    "dropped_message_ids",
    "summarized_message_ids",
    "pre_message_count",
    "pre_token_count",
    "truncated",
    "usage",
    "retries",
    "status",
    "budget_event_ref",
    "started_at",
    "finished_at"
  ],
  "title": "ContextCompactionReceipt",
  "type": "object"
}
