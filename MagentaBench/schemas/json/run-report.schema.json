{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Content-addressed reference to an artifact stored outside the manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ClaimReport": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "claim_eligible": {
                "const": false
              }
            }
          },
          "if": {
            "properties": {
              "gates": {
                "properties": {
                  "execution_valid": {
                    "properties": {
                      "valid": {
                        "const": true
                      }
                    },
                    "required": [
                      "valid"
                    ]
                  },
                  "isolation_valid": {
                    "properties": {
                      "valid": {
                        "const": true
                      }
                    },
                    "required": [
                      "valid"
                    ]
                  },
                  "protocol_valid": {
                    "properties": {
                      "valid": {
                        "const": true
                      }
                    },
                    "required": [
                      "valid"
                    ]
                  },
                  "scoring_valid": {
                    "properties": {
                      "valid": {
                        "const": true
                      }
                    },
                    "required": [
                      "valid"
                    ]
                  },
                  "statistics_valid": {
                    "properties": {
                      "valid": {
                        "const": true
                      }
                    },
                    "required": [
                      "valid"
                    ]
                  }
                },
                "required": [
                  "execution_valid",
                  "protocol_valid",
                  "isolation_valid",
                  "scoring_valid",
                  "statistics_valid"
                ]
              }
            },
            "required": [
              "gates"
            ]
          },
          "then": {
            "properties": {
              "claim_eligible": {
                "const": true
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "effect_is_causal_claim": {
                "const": false
              }
            }
          },
          "if": {
            "properties": {
              "claim_eligible": {
                "const": true
              },
              "effect": {
                "type": "object"
              }
            },
            "required": [
              "claim_eligible",
              "effect"
            ]
          },
          "then": {
            "properties": {
              "effect_is_causal_claim": {
                "const": true
              }
            }
          }
        }
      ],
      "properties": {
        "claim_eligible": {
          "description": "Whether every independently recorded validity gate passes.",
          "readOnly": true,
          "title": "Claim Eligible",
          "type": "boolean"
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/EffectEstimate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effect_is_causal_claim": {
          "description": "Whether an estimate may be described using causal claim language.",
          "readOnly": true,
          "title": "Effect Is Causal Claim",
          "type": "boolean"
        },
        "experiment_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Experiment Id",
          "type": "string"
        },
        "failure_breakdown": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/RunStatus"
          },
          "title": "Failure Breakdown",
          "type": "object"
        },
        "gates": {
          "additionalProperties": {
            "$ref": "#/$defs/GateResult"
          },
          "maxProperties": 5,
          "minProperties": 5,
          "propertyNames": {
            "enum": [
              "execution_valid",
              "protocol_valid",
              "isolation_valid",
              "scoring_valid",
              "statistics_valid"
            ]
          },
          "title": "Gates",
          "type": "object"
        },
        "lineage": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LineageRef"
          },
          "title": "Lineage",
          "type": "array"
        },
        "manifest_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "purpose": {
          "const": "claim",
          "title": "Purpose",
          "type": "string"
        },
        "record_index_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "subject_kind": {
          "$ref": "#/$defs/SubjectKind"
        }
      },
      "required": [
        "purpose",
        "subject_kind",
        "experiment_id",
        "manifest_digest",
        "gates",
        "claim_eligible",
        "effect_is_causal_claim"
      ],
      "title": "ClaimReport",
      "type": "object"
    },
    "EffectEstimate": {
      "additionalProperties": false,
      "properties": {
        "confidence_interval": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Confidence Interval",
          "type": "array"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "n_pairs": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Pairs"
        },
        "n_runs": {
          "minimum": 1,
          "title": "N Runs",
          "type": "integer"
        },
        "point_estimate": {
          "title": "Point Estimate",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "point_estimate",
        "confidence_interval",
        "n_runs"
      ],
      "title": "EffectEstimate",
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "valid": {
                "const": false
              }
            },
            "required": [
              "valid"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "valid": {
                "const": true
              }
            },
            "required": [
              "valid"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "evidence_refs"
            ]
          }
        }
      ],
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "valid"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "LineageRef": {
      "additionalProperties": false,
      "description": "Bindings from one parent plan run to its selected child attempt.",
      "properties": {
        "attempt_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Attempt Id",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Case Id",
          "type": "string"
        },
        "case_set_receipt_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "evidence_bundle_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Run Id",
          "type": "string"
        },
        "schedule_receipt_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "run_id",
        "attempt_id",
        "case_id",
        "evidence_bundle_ref",
        "schedule_receipt_ref",
        "case_set_receipt_ref"
      ],
      "title": "LineageRef",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "n_runs": {
          "minimum": 1,
          "title": "N Runs",
          "type": "integer"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "value",
        "n_runs"
      ],
      "title": "Observation",
      "type": "object"
    },
    "ObservationReport": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "isolation_reasons": {
                "minItems": 1
              }
            }
          },
          "if": {
            "properties": {
              "isolation_valid": {
                "const": true
              }
            },
            "required": [
              "isolation_valid"
            ]
          },
          "then": {
            "properties": {
              "isolation_reasons": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "description": "Exploratory observations with no claim eligibility or causal fields.",
      "properties": {
        "experiment_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Experiment Id",
          "type": "string"
        },
        "failure_breakdown": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/RunStatus"
          },
          "title": "Failure Breakdown",
          "type": "object"
        },
        "isolation_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Isolation Reasons",
          "type": "array"
        },
        "isolation_valid": {
          "title": "Isolation Valid",
          "type": "boolean"
        },
        "lineage": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LineageRef"
          },
          "title": "Lineage",
          "type": "array"
        },
        "manifest_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "observations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "title": "Observations",
          "type": "array"
        },
        "purpose": {
          "const": "exploratory",
          "title": "Purpose",
          "type": "string"
        },
        "record_index_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "subject_kind": {
          "$ref": "#/$defs/SubjectKind"
        }
      },
      "required": [
        "purpose",
        "subject_kind",
        "experiment_id",
        "manifest_digest",
        "isolation_valid",
        "isolation_reasons"
      ],
      "title": "ObservationReport",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "pass",
        "verified_fail",
        "scored",
        "no_output",
        "invalid_output",
        "timeout",
        "agent_error",
        "harness_fault",
        "verifier_error",
        "infra_error",
        "unsupported"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SubjectKind": {
      "description": "Resolved kind of the subject that actually entered an execution path.",
      "enum": [
        "hcp_harness",
        "opaque_agent",
        "evolver",
        "meta_evolver",
        "fake"
      ],
      "title": "SubjectKind",
      "type": "string"
    }
  },
  "discriminator": {
    "mapping": {
      "claim": "#/$defs/ClaimReport",
      "exploratory": "#/$defs/ObservationReport"
    },
    "propertyName": "purpose"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ObservationReport"
    },
    {
      "$ref": "#/$defs/ClaimReport"
    }
  ]
}
