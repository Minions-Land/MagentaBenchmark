{
  "additionalProperties": false,
  "description": "Identity-bearing credential digest; secret values are never serialized.",
  "properties": {
    "name": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Name",
      "type": "string"
    },
    "secret": {
      "const": true,
      "title": "Secret",
      "type": "boolean"
    },
    "source_file": {
      "minLength": 1,
      "title": "Source File",
      "type": "string"
    },
    "value_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Value Sha256",
      "type": "string"
    }
  },
  "required": [
    "name",
    "value_sha256",
    "secret",
    "source_file"
  ],
  "title": "CredentialRef",
  "type": "object"
}
