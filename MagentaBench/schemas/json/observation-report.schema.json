{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Content-addressed reference to an artifact stored outside the manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "LineageRef": {
      "additionalProperties": false,
      "description": "Bindings from one parent plan run to its selected child attempt.",
      "properties": {
        "attempt_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Attempt Id",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Case Id",
          "type": "string"
        },
        "case_set_receipt_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "evidence_bundle_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Run Id",
          "type": "string"
        },
        "schedule_receipt_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "run_id",
        "attempt_id",
        "case_id",
        "evidence_bundle_ref",
        "schedule_receipt_ref",
        "case_set_receipt_ref"
      ],
      "title": "LineageRef",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "n_runs": {
          "minimum": 1,
          "title": "N Runs",
          "type": "integer"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "value",
        "n_runs"
      ],
      "title": "Observation",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "pass",
        "verified_fail",
        "scored",
        "no_output",
        "invalid_output",
        "timeout",
        "agent_error",
        "harness_fault",
        "verifier_error",
        "infra_error",
        "unsupported"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SubjectKind": {
      "description": "Resolved kind of the subject that actually entered an execution path.",
      "enum": [
        "hcp_harness",
        "opaque_agent",
        "evolver",
        "meta_evolver",
        "fake"
      ],
      "title": "SubjectKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "protocol_reasons": {
            "minItems": 1
          }
        }
      },
      "if": {
        "properties": {
          "protocol_valid": {
            "const": true
          }
        },
        "required": [
          "protocol_valid"
        ]
      },
      "then": {
        "properties": {
          "protocol_reasons": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "isolation_reasons": {
            "minItems": 1
          }
        }
      },
      "if": {
        "properties": {
          "isolation_valid": {
            "const": true
          }
        },
        "required": [
          "isolation_valid"
        ]
      },
      "then": {
        "properties": {
          "isolation_reasons": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "description": "Exploratory observations with no claim eligibility or causal fields.",
  "properties": {
    "experiment_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Experiment Id",
      "type": "string"
    },
    "failure_breakdown": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "#/$defs/RunStatus"
      },
      "title": "Failure Breakdown",
      "type": "object"
    },
    "isolation_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Isolation Reasons",
      "type": "array"
    },
    "isolation_valid": {
      "title": "Isolation Valid",
      "type": "boolean"
    },
    "lineage": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LineageRef"
      },
      "title": "Lineage",
      "type": "array"
    },
    "manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "observations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Observations",
      "type": "array"
    },
    "protocol_reasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Protocol Reasons",
      "type": "array"
    },
    "protocol_valid": {
      "default": true,
      "title": "Protocol Valid",
      "type": "boolean"
    },
    "purpose": {
      "const": "exploratory",
      "title": "Purpose",
      "type": "string"
    },
    "record_index_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "subject_kind": {
      "$ref": "#/$defs/SubjectKind"
    }
  },
  "required": [
    "purpose",
    "subject_kind",
    "experiment_id",
    "manifest_digest",
    "isolation_valid",
    "isolation_reasons"
  ],
  "title": "ObservationReport",
  "type": "object"
}
