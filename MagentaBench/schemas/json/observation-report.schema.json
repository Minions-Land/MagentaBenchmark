{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Content-addressed reference to an artifact stored outside the manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ComparisonKind": {
      "description": "The four semantic subjects that BMP is allowed to compare.",
      "enum": [
        "agent",
        "coding_agent",
        "evolution_method",
        "meta_evolution_method"
      ],
      "title": "ComparisonKind",
      "type": "string"
    },
    "LineageRef": {
      "additionalProperties": false,
      "description": "Bindings from one parent plan run to its selected child attempt.",
      "properties": {
        "attempt_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Attempt Id",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Case Id",
          "type": "string"
        },
        "case_set_receipt_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "evidence_bundle_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Run Id",
          "type": "string"
        },
        "schedule_receipt_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "run_id",
        "attempt_id",
        "case_id",
        "evidence_bundle_ref",
        "schedule_receipt_ref",
        "case_set_receipt_ref"
      ],
      "title": "LineageRef",
      "type": "object"
    },
    "MetricComputationState": {
      "enum": [
        "complete",
        "unavailable",
        "invalid"
      ],
      "title": "MetricComputationState",
      "type": "string"
    },
    "MetricResult": {
      "additionalProperties": false,
      "description": "Replayable metric output over one resolved configuration/run arm.",
      "properties": {
        "denominator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "excluded_count": {
          "minimum": 0,
          "title": "Excluded Count",
          "type": "integer"
        },
        "input_metric_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Metric Ids",
          "type": "array"
        },
        "invalid_count": {
          "minimum": 0,
          "title": "Invalid Count",
          "type": "integer"
        },
        "manifest_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "metric_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Metric Digest",
          "type": "string"
        },
        "metric_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Metric Id",
          "type": "string"
        },
        "missing_count": {
          "minimum": 0,
          "title": "Missing Count",
          "type": "integer"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "observed_count": {
          "minimum": 0,
          "title": "Observed Count",
          "type": "integer"
        },
        "parent_run_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Parent Run Id",
          "type": "string"
        },
        "planned_rollout_count": {
          "minimum": 1,
          "title": "Planned Rollout Count",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "rollouts_per_task": {
          "minimum": 1,
          "title": "Rollouts Per Task",
          "type": "integer"
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/MetricSample"
          },
          "title": "Samples",
          "type": "array"
        },
        "schedule_receipt_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "state": {
          "$ref": "#/$defs/MetricComputationState"
        },
        "status_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/RunStatus"
          },
          "title": "Status Counts",
          "type": "object"
        },
        "task_count": {
          "minimum": 1,
          "title": "Task Count",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "zero_filled_count": {
          "minimum": 0,
          "title": "Zero Filled Count",
          "type": "integer"
        }
      },
      "required": [
        "metric_id",
        "metric_digest",
        "manifest_digest",
        "parent_run_id",
        "schedule_receipt_ref",
        "state",
        "planned_rollout_count",
        "task_count",
        "rollouts_per_task",
        "observed_count",
        "zero_filled_count",
        "excluded_count",
        "missing_count",
        "invalid_count",
        "status_counts",
        "samples"
      ],
      "title": "MetricResult",
      "type": "object"
    },
    "MetricSample": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Attempt Id",
          "type": "string"
        },
        "attempt_index": {
          "minimum": 0,
          "title": "Attempt Index",
          "type": "integer"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Case Id",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/MetricSampleDisposition"
        },
        "evidence_bundle_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "trajectory_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "attempt_id",
        "case_id",
        "attempt_index",
        "status",
        "disposition"
      ],
      "title": "MetricSample",
      "type": "object"
    },
    "MetricSampleDisposition": {
      "enum": [
        "observed",
        "zero_filled",
        "excluded",
        "missing",
        "invalid"
      ],
      "title": "MetricSampleDisposition",
      "type": "string"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "n_runs": {
          "minimum": 1,
          "title": "N Runs",
          "type": "integer"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "value",
        "n_runs"
      ],
      "title": "Observation",
      "type": "object"
    },
    "RunStatus": {
      "description": "Closed outcome taxonomy retained for every planned rollout.",
      "enum": [
        "pass",
        "verified_fail",
        "scored",
        "no_output",
        "invalid_output",
        "timeout",
        "agent_error",
        "harness_fault",
        "verifier_error",
        "infra_error",
        "unsupported"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SubjectKind": {
      "description": "Execution/artifact shape that actually entered an execution path.\n\nThis is deliberately separate from :class:`ComparisonKind`: two subjects\nwith different runtime packaging (for example ``hcp_harness`` and\n``opaque_agent``) can both represent a complete Coding Agent.",
      "enum": [
        "hcp_harness",
        "opaque_agent",
        "evolver",
        "meta_evolver",
        "fake"
      ],
      "title": "SubjectKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "protocol_reasons": {
            "minItems": 1
          }
        }
      },
      "if": {
        "properties": {
          "protocol_valid": {
            "const": true
          }
        },
        "required": [
          "protocol_valid"
        ]
      },
      "then": {
        "properties": {
          "protocol_reasons": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "isolation_reasons": {
            "minItems": 1
          }
        }
      },
      "if": {
        "properties": {
          "isolation_valid": {
            "const": true
          }
        },
        "required": [
          "isolation_valid"
        ]
      },
      "then": {
        "properties": {
          "isolation_reasons": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "description": "Exploratory observations with no claim eligibility or causal fields.",
  "properties": {
    "comparison_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComparisonKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "experiment_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Experiment Id",
      "type": "string"
    },
    "failure_breakdown": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "#/$defs/RunStatus"
      },
      "title": "Failure Breakdown",
      "type": "object"
    },
    "isolation_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Isolation Reasons",
      "type": "array"
    },
    "isolation_valid": {
      "title": "Isolation Valid",
      "type": "boolean"
    },
    "lineage": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LineageRef"
      },
      "title": "Lineage",
      "type": "array"
    },
    "manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "metric_results": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MetricResult"
      },
      "title": "Metric Results",
      "type": "array"
    },
    "observations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Observations",
      "type": "array"
    },
    "protocol_reasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Protocol Reasons",
      "type": "array"
    },
    "protocol_valid": {
      "default": true,
      "title": "Protocol Valid",
      "type": "boolean"
    },
    "purpose": {
      "const": "exploratory",
      "title": "Purpose",
      "type": "string"
    },
    "record_index_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "subject_kinds": {
      "items": {
        "$ref": "#/$defs/SubjectKind"
      },
      "title": "Subject Kinds",
      "type": "array"
    }
  },
  "required": [
    "purpose",
    "subject_kinds",
    "experiment_id",
    "manifest_digest",
    "isolation_valid",
    "isolation_reasons"
  ],
  "title": "ObservationReport",
  "type": "object"
}
