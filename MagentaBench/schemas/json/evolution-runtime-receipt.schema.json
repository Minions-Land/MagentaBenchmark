{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Content-addressed reference to an artifact stored outside the manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "description": "Hard limits for a run; absent fields mean that limit is unspecified.",
      "properties": {
        "max_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_wall_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Seconds"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "BudgetAllocation": {
      "additionalProperties": false,
      "description": "Pre-launch token/cost allocation; wall time remains global.",
      "properties": {
        "max_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        }
      },
      "title": "BudgetAllocation",
      "type": "object"
    },
    "EvolutionBudgetEvent": {
      "additionalProperties": false,
      "description": "One measured operation debit and its root-budget lineage.",
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "budget_exceeded": {
          "default": false,
          "title": "Budget Exceeded",
          "type": "boolean"
        },
        "candidate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Ids",
          "type": "array"
        },
        "event_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Event Id",
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/EvolutionBudgetOperation"
        },
        "remaining_after": {
          "$ref": "#/$defs/BudgetAllocation"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "spent": {
          "$ref": "#/$defs/UsageRecord"
        },
        "usage_observable": {
          "title": "Usage Observable",
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "sequence",
        "operation",
        "candidate_ids",
        "spent",
        "usage_observable",
        "remaining_after"
      ],
      "title": "EvolutionBudgetEvent",
      "type": "object"
    },
    "EvolutionBudgetLedger": {
      "additionalProperties": false,
      "description": "Root evolution budget replayed across every billable operation.",
      "properties": {
        "budget_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Budget Digest",
          "type": "string"
        },
        "budget_exceeded": {
          "title": "Budget Exceeded",
          "type": "boolean"
        },
        "budget_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "declared_budget": {
          "$ref": "#/$defs/Budget"
        },
        "elapsed_wall_seconds": {
          "minimum": 0,
          "title": "Elapsed Wall Seconds",
          "type": "number"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/EvolutionBudgetEvent"
          },
          "minItems": 1,
          "title": "Events",
          "type": "array"
        },
        "reconciles_exactly": {
          "title": "Reconciles Exactly",
          "type": "boolean"
        },
        "total_usage": {
          "$ref": "#/$defs/UsageRecord"
        },
        "usage_observable": {
          "title": "Usage Observable",
          "type": "boolean"
        }
      },
      "required": [
        "budget_digest",
        "budget_ref",
        "declared_budget",
        "events",
        "total_usage",
        "elapsed_wall_seconds",
        "usage_observable",
        "reconciles_exactly",
        "budget_exceeded"
      ],
      "title": "EvolutionBudgetLedger",
      "type": "object"
    },
    "EvolutionBudgetOperation": {
      "description": "Billable operations understood by the neutral runtime.",
      "enum": [
        "parent_evolution",
        "seed",
        "generate",
        "search_evaluate",
        "revise",
        "holdout_evaluate"
      ],
      "title": "EvolutionBudgetOperation",
      "type": "string"
    },
    "EvolutionEvaluationRecord": {
      "additionalProperties": false,
      "description": "One content-addressed query to search or sealed-holdout evaluation.",
      "properties": {
        "after_transition_sequence": {
          "minimum": 0,
          "title": "After Transition Sequence",
          "type": "integer"
        },
        "budget_event_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Budget Event Id",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Candidate Id",
          "type": "string"
        },
        "candidate_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "evaluation_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "evaluator_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evaluator Digest",
          "type": "string"
        },
        "evaluator_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "request_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "result_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "score_metric": {
          "minLength": 1,
          "title": "Score Metric",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "split_manifest_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "stage": {
          "$ref": "#/$defs/EvolutionEvaluationStage"
        }
      },
      "required": [
        "evaluation_id",
        "sequence",
        "stage",
        "candidate_id",
        "evaluator_digest",
        "evaluator_ref",
        "split_manifest_ref",
        "candidate_ref",
        "request_ref",
        "result_ref",
        "score",
        "score_metric",
        "budget_event_id",
        "after_transition_sequence"
      ],
      "title": "EvolutionEvaluationRecord",
      "type": "object"
    },
    "EvolutionEvaluationStage": {
      "description": "Evaluator authority used for one query.",
      "enum": [
        "search",
        "sealed_holdout"
      ],
      "title": "EvolutionEvaluationStage",
      "type": "string"
    },
    "EvolutionSealedHoldoutReceipt": {
      "additionalProperties": false,
      "description": "Evidence that the authoritative split opened only after selection.",
      "properties": {
        "access_count": {
          "const": 1,
          "default": 1,
          "title": "Access Count",
          "type": "integer"
        },
        "format": {
          "const": "bmp-evolution-sealed-holdout-v1",
          "default": "bmp-evolution-sealed-holdout-v1",
          "title": "Format",
          "type": "string"
        },
        "holdout_evaluation_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Holdout Evaluation Id",
          "type": "string"
        },
        "holdout_evaluation_sequence": {
          "minimum": 0,
          "title": "Holdout Evaluation Sequence",
          "type": "integer"
        },
        "holdout_evaluator_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Holdout Evaluator Digest",
          "type": "string"
        },
        "search_evaluator_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Search Evaluator Digest",
          "type": "string"
        },
        "selected_candidate_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Selected Candidate Id",
          "type": "string"
        },
        "selection_transition_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Selection Transition Id",
          "type": "string"
        },
        "selection_transition_sequence": {
          "minimum": 0,
          "title": "Selection Transition Sequence",
          "type": "integer"
        },
        "split_manifest_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "split_manifest_ref",
        "search_evaluator_digest",
        "holdout_evaluator_digest",
        "selected_candidate_id",
        "selection_transition_id",
        "selection_transition_sequence",
        "holdout_evaluation_id",
        "holdout_evaluation_sequence"
      ],
      "title": "EvolutionSealedHoldoutReceipt",
      "type": "object"
    },
    "UsageRecord": {
      "additionalProperties": false,
      "properties": {
        "cache_read_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Read Tokens"
        },
        "cache_write_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Write Tokens"
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tokens"
        },
        "wall_clock_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Clock Seconds"
        }
      },
      "title": "UsageRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete execution audit bound to one ``EvolutionRunEvidence`` record.",
  "properties": {
    "adapter_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Adapter Digest",
      "type": "string"
    },
    "budget_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Budget Digest",
      "type": "string"
    },
    "budget_ledger": {
      "$ref": "#/$defs/EvolutionBudgetLedger"
    },
    "candidate_ledger_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Ledger Digest",
      "type": "string"
    },
    "evaluations": {
      "items": {
        "$ref": "#/$defs/EvolutionEvaluationRecord"
      },
      "minItems": 2,
      "title": "Evaluations",
      "type": "array"
    },
    "evaluator_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evaluator Digest",
      "type": "string"
    },
    "format": {
      "const": "bmp-evolution-runtime-v1",
      "default": "bmp-evolution-runtime-v1",
      "title": "Format",
      "type": "string"
    },
    "kind": {
      "enum": [
        "evolver",
        "meta_evolver"
      ],
      "title": "Kind",
      "type": "string"
    },
    "parent_evidence_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Run Id",
      "type": "string"
    },
    "sealed_holdout": {
      "$ref": "#/$defs/EvolutionSealedHoldoutReceipt"
    },
    "selected_candidate_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Selected Candidate Id",
      "type": "string"
    },
    "transition_ledger_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Transition Ledger Digest",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "kind",
    "adapter_digest",
    "evaluator_digest",
    "budget_digest",
    "candidate_ledger_digest",
    "transition_ledger_digest",
    "selected_candidate_id",
    "evaluations",
    "budget_ledger",
    "sealed_holdout"
  ],
  "title": "EvolutionRuntimeReceipt",
  "type": "object"
}
