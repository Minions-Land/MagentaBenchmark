{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Content-addressed reference to an artifact stored outside the manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "description": "Hard limits for a run; absent fields mean that limit is unspecified.",
      "properties": {
        "max_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_wall_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Seconds"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "BudgetAllocation": {
      "additionalProperties": false,
      "description": "Pre-launch token/cost allocation; wall time remains global.",
      "properties": {
        "max_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        }
      },
      "title": "BudgetAllocation",
      "type": "object"
    },
    "EvolutionArchiveEntry": {
      "additionalProperties": false,
      "description": "One candidate's immutable state in an archive snapshot.",
      "properties": {
        "candidate_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Candidate Id",
          "type": "string"
        },
        "candidate_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "child_count": {
          "default": 0,
          "minimum": 0,
          "title": "Child Count",
          "type": "integer"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "lineage_depth": {
          "default": 0,
          "minimum": 0,
          "title": "Lineage Depth",
          "type": "integer"
        },
        "parent_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Parent Ids",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "score_metric": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score Metric"
        },
        "status": {
          "enum": [
            "ineligible",
            "eligible",
            "retained",
            "promoted",
            "evicted"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "generation",
        "candidate_ref",
        "status"
      ],
      "title": "EvolutionArchiveEntry",
      "type": "object"
    },
    "EvolutionArchiveLedger": {
      "additionalProperties": false,
      "description": "Complete archive history; no state may be reconstructed from a snapshot.",
      "properties": {
        "evaluator_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evaluator Digest",
          "type": "string"
        },
        "final_archive_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Final Archive Digest",
          "type": "string"
        },
        "format": {
          "const": "bmp-evolution-archive-ledger-v1",
          "default": "bmp-evolution-archive-ledger-v1",
          "title": "Format",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/EvolutionSelectionPolicy"
        },
        "transitions": {
          "items": {
            "$ref": "#/$defs/EvolutionArchiveTransition"
          },
          "minItems": 1,
          "title": "Transitions",
          "type": "array"
        }
      },
      "required": [
        "policy",
        "evaluator_digest",
        "transitions",
        "final_archive_digest"
      ],
      "title": "EvolutionArchiveLedger",
      "type": "object"
    },
    "EvolutionArchiveSnapshot": {
      "additionalProperties": false,
      "description": "A complete archive population at one transition boundary.",
      "properties": {
        "entries": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvolutionArchiveEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "evaluator_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evaluator Digest",
          "type": "string"
        },
        "format": {
          "const": "bmp-evolution-archive-snapshot-v1",
          "default": "bmp-evolution-archive-snapshot-v1",
          "title": "Format",
          "type": "string"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        }
      },
      "required": [
        "evaluator_digest",
        "metric",
        "policy_digest"
      ],
      "title": "EvolutionArchiveSnapshot",
      "type": "object"
    },
    "EvolutionArchiveTransition": {
      "additionalProperties": false,
      "description": "Hash-chained before/after archive state for one lifecycle transition.",
      "properties": {
        "after": {
          "$ref": "#/$defs/EvolutionArchiveSnapshot"
        },
        "after_archive_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "After Archive Digest",
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/EvolutionArchiveSnapshot"
        },
        "before_archive_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Before Archive Digest",
          "type": "string"
        },
        "candidate_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Candidate Ids",
          "type": "array"
        },
        "eligible_candidate_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Eligible Candidate Ids",
          "type": "array"
        },
        "phase": {
          "$ref": "#/$defs/EvolutionArchiveTransitionPhase"
        },
        "policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "previous_transition_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Transition Digest"
        },
        "promotion_gate_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Promotion Gate Id"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "selected_candidate_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Candidate Id"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "transition_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Transition Id",
          "type": "string"
        }
      },
      "required": [
        "transition_id",
        "sequence",
        "phase",
        "before",
        "after",
        "before_archive_digest",
        "after_archive_digest",
        "policy_digest",
        "reason"
      ],
      "title": "EvolutionArchiveTransition",
      "type": "object"
    },
    "EvolutionArchiveTransitionPhase": {
      "description": "Lifecycle boundary represented by an archive transition.",
      "enum": [
        "seed",
        "generate",
        "staged_evaluation",
        "revise",
        "select",
        "promote",
        "terminate"
      ],
      "title": "EvolutionArchiveTransitionPhase",
      "type": "string"
    },
    "EvolutionBudgetEvent": {
      "additionalProperties": false,
      "description": "One measured operation debit and its root-budget lineage.",
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "budget_exceeded": {
          "default": false,
          "title": "Budget Exceeded",
          "type": "boolean"
        },
        "candidate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Ids",
          "type": "array"
        },
        "event_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Event Id",
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/EvolutionBudgetOperation"
        },
        "remaining_after": {
          "$ref": "#/$defs/BudgetAllocation"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "spent": {
          "$ref": "#/$defs/UsageRecord"
        },
        "usage_observable": {
          "title": "Usage Observable",
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "sequence",
        "operation",
        "candidate_ids",
        "spent",
        "usage_observable",
        "remaining_after"
      ],
      "title": "EvolutionBudgetEvent",
      "type": "object"
    },
    "EvolutionBudgetLedger": {
      "additionalProperties": false,
      "description": "Root evolution budget replayed across every billable operation.",
      "properties": {
        "budget_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Budget Digest",
          "type": "string"
        },
        "budget_exceeded": {
          "title": "Budget Exceeded",
          "type": "boolean"
        },
        "budget_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "declared_budget": {
          "$ref": "#/$defs/Budget"
        },
        "elapsed_wall_seconds": {
          "minimum": 0,
          "title": "Elapsed Wall Seconds",
          "type": "number"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/EvolutionBudgetEvent"
          },
          "minItems": 1,
          "title": "Events",
          "type": "array"
        },
        "reconciles_exactly": {
          "title": "Reconciles Exactly",
          "type": "boolean"
        },
        "total_usage": {
          "$ref": "#/$defs/UsageRecord"
        },
        "usage_observable": {
          "title": "Usage Observable",
          "type": "boolean"
        }
      },
      "required": [
        "budget_digest",
        "budget_ref",
        "declared_budget",
        "events",
        "total_usage",
        "elapsed_wall_seconds",
        "usage_observable",
        "reconciles_exactly",
        "budget_exceeded"
      ],
      "title": "EvolutionBudgetLedger",
      "type": "object"
    },
    "EvolutionBudgetOperation": {
      "description": "Billable operations understood by the neutral runtime.",
      "enum": [
        "parent_evolution",
        "seed",
        "generate",
        "search_evaluate",
        "revise",
        "holdout_evaluate",
        "coding_agent_call",
        "meta_agent_call",
        "diagnosis",
        "parent_selection",
        "staged_evaluation",
        "full_evaluation",
        "retry",
        "checkpoint",
        "container_build",
        "failure_sampling"
      ],
      "title": "EvolutionBudgetOperation",
      "type": "string"
    },
    "EvolutionDiagnosisReceipt": {
      "additionalProperties": false,
      "description": "Content-addressed diagnosis of one sampled failure.",
      "properties": {
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "budget_event_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Budget Event Id",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Candidate Id",
          "type": "string"
        },
        "diagnosis_component_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Diagnosis Component Digest",
          "type": "string"
        },
        "diagnosis_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Diagnosis Id",
          "type": "string"
        },
        "failure_evidence_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Failure Evidence Refs",
          "type": "array"
        },
        "failure_sampling_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Failure Sampling Id",
          "type": "string"
        },
        "format": {
          "const": "bmp-evolution-diagnosis-v1",
          "default": "bmp-evolution-diagnosis-v1",
          "title": "Format",
          "type": "string"
        },
        "prompt_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "result_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "retry_recommended": {
          "title": "Retry Recommended",
          "type": "boolean"
        },
        "root_cause": {
          "minLength": 1,
          "title": "Root Cause",
          "type": "string"
        },
        "sampled_item_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Sampled Item Id",
          "type": "string"
        }
      },
      "required": [
        "diagnosis_id",
        "failure_sampling_id",
        "sampled_item_id",
        "candidate_id",
        "diagnosis_component_digest",
        "prompt_ref",
        "result_ref",
        "failure_evidence_refs",
        "budget_event_id",
        "root_cause",
        "retry_recommended"
      ],
      "title": "EvolutionDiagnosisReceipt",
      "type": "object"
    },
    "EvolutionEvaluationRecord": {
      "additionalProperties": false,
      "description": "One content-addressed query to search or sealed-holdout evaluation.",
      "properties": {
        "after_transition_sequence": {
          "minimum": 0,
          "title": "After Transition Sequence",
          "type": "integer"
        },
        "budget_event_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Budget Event Id",
          "type": "string"
        },
        "candidate_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Candidate Id",
          "type": "string"
        },
        "candidate_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "evaluation_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "evaluator_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evaluator Digest",
          "type": "string"
        },
        "evaluator_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "request_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "result_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "score": {
          "title": "Score",
          "type": "number"
        },
        "score_metric": {
          "minLength": 1,
          "title": "Score Metric",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "split_manifest_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "stage": {
          "$ref": "#/$defs/EvolutionEvaluationStage"
        }
      },
      "required": [
        "evaluation_id",
        "sequence",
        "stage",
        "candidate_id",
        "evaluator_digest",
        "evaluator_ref",
        "split_manifest_ref",
        "candidate_ref",
        "request_ref",
        "result_ref",
        "score",
        "score_metric",
        "budget_event_id",
        "after_transition_sequence"
      ],
      "title": "EvolutionEvaluationRecord",
      "type": "object"
    },
    "EvolutionEvaluationStage": {
      "description": "Evaluator authority used for one query.",
      "enum": [
        "search",
        "sealed_holdout"
      ],
      "title": "EvolutionEvaluationStage",
      "type": "string"
    },
    "EvolutionFailureSample": {
      "additionalProperties": false,
      "description": "One member of the complete population considered for diagnosis.\n\nSuccessful and failed members are retained together.  This keeps the\nfailure-sampling denominator auditable and prevents adapters from building\na convenient sample by silently dropping infrastructure failures.",
      "properties": {
        "candidate_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Candidate Id",
          "type": "string"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "included": {
          "title": "Included",
          "type": "boolean"
        },
        "inclusion_probability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Inclusion Probability",
          "type": "number"
        },
        "item_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Item Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "success",
            "task_failure",
            "no_output",
            "invalid_output",
            "timeout",
            "agent_error",
            "harness_fault",
            "verifier_error",
            "infra_error",
            "unsupported"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "candidate_id",
        "outcome",
        "eligible",
        "included",
        "inclusion_probability",
        "evidence_refs"
      ],
      "title": "EvolutionFailureSample",
      "type": "object"
    },
    "EvolutionFailureSamplingReceipt": {
      "additionalProperties": false,
      "description": "Replayable selection of failures passed to a diagnosis component.",
      "properties": {
        "budget_event_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Event Id"
        },
        "complete_population": {
          "const": true,
          "default": true,
          "title": "Complete Population",
          "type": "boolean"
        },
        "format": {
          "const": "bmp-evolution-failure-sampling-v1",
          "default": "bmp-evolution-failure-sampling-v1",
          "title": "Format",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Policy Id",
          "type": "string"
        },
        "population": {
          "items": {
            "$ref": "#/$defs/EvolutionFailureSample"
          },
          "minItems": 1,
          "title": "Population",
          "type": "array"
        },
        "population_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Population Digest",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "rng_algorithm": {
          "default": "none",
          "minLength": 1,
          "title": "Rng Algorithm",
          "type": "string"
        },
        "rng_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rng Seed"
        },
        "rng_state_after": {
          "default": "none",
          "minLength": 1,
          "title": "Rng State After",
          "type": "string"
        },
        "rng_state_before": {
          "default": "none",
          "minLength": 1,
          "title": "Rng State Before",
          "type": "string"
        },
        "sample_size": {
          "minimum": 0,
          "title": "Sample Size",
          "type": "integer"
        },
        "sampling_algorithm": {
          "minLength": 1,
          "title": "Sampling Algorithm",
          "type": "string"
        },
        "sampling_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Sampling Id",
          "type": "string"
        },
        "selected_item_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Selected Item Ids",
          "type": "array"
        }
      },
      "required": [
        "sampling_id",
        "policy_id",
        "population",
        "population_digest",
        "sample_size",
        "sampling_algorithm",
        "reason"
      ],
