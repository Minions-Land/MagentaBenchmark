{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Content-addressed reference to an artifact stored outside the manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ComparisonKind": {
      "description": "The four semantic subjects that BMP is allowed to compare.",
      "enum": [
        "agent",
        "coding_agent",
        "evolution_method",
        "meta_evolution_method"
      ],
      "title": "ComparisonKind",
      "type": "string"
    },
    "EffectEstimate": {
      "additionalProperties": false,
      "properties": {
        "confidence_interval": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Confidence Interval",
          "type": "array"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "n_pairs": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Pairs"
        },
        "n_runs": {
          "minimum": 1,
          "title": "N Runs",
          "type": "integer"
        },
        "point_estimate": {
          "title": "Point Estimate",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "point_estimate",
        "confidence_interval",
        "n_runs"
      ],
      "title": "EffectEstimate",
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "valid": {
                "const": false
              }
            },
            "required": [
              "valid"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "valid": {
                "const": true
              }
            },
            "required": [
              "valid"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "evidence_refs"
            ]
          }
        }
      ],
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "valid"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "LineageRef": {
      "additionalProperties": false,
      "description": "Bindings from one parent plan run to its selected child attempt.",
      "properties": {
        "attempt_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Attempt Id",
          "type": "string"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Case Id",
          "type": "string"
        },
        "case_set_receipt_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "evidence_bundle_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Run Id",
          "type": "string"
        },
        "schedule_receipt_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "run_id",
        "attempt_id",
        "case_id",
        "evidence_bundle_ref",
        "schedule_receipt_ref",
        "case_set_receipt_ref"
      ],
      "title": "LineageRef",
      "type": "object"
    },
    "MetricComputationState": {
      "enum": [
        "complete",
        "unavailable",
        "invalid"
      ],
      "title": "MetricComputationState",
      "type": "string"
    },
    "MetricResult": {
      "additionalProperties": false,
      "description": "Replayable metric output over one resolved configuration/run arm.",
      "properties": {
        "denominator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "excluded_count": {
          "minimum": 0,
          "title": "Excluded Count",
          "type": "integer"
        },
        "input_metric_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Metric Ids",
          "type": "array"
        },
        "invalid_count": {
          "minimum": 0,
          "title": "Invalid Count",
          "type": "integer"
        },
        "manifest_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Digest",
          "type": "string"
        },
        "metric_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Metric Digest",
          "type": "string"
        },
        "metric_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Metric Id",
          "type": "string"
        },
        "missing_count": {
          "minimum": 0,
          "title": "Missing Count",
          "type": "integer"
        },
        "numerator": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "observed_count": {
          "minimum": 0,
          "title": "Observed Count",
          "type": "integer"
        },
        "parent_run_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Parent Run Id",
          "type": "string"
        },
        "planned_rollout_count": {
          "minimum": 1,
          "title": "Planned Rollout Count",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "rollouts_per_task": {
          "minimum": 1,
          "title": "Rollouts Per Task",
          "type": "integer"
        },
        "samples": {
          "items": {
            "$ref": "#/$defs/MetricSample"
          },
          "title": "Samples",
          "type": "array"
        },
        "schedule_receipt_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "state": {
          "$ref": "#/$defs/MetricComputationState"
        },
        "status_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/RunStatus"
          },
          "title": "Status Counts",
          "type": "object"
        },
        "task_count": {
          "minimum": 1,
          "title": "Task Count",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "zero_filled_count": {
          "minimum": 0,
          "title": "Zero Filled Count",
          "type": "integer"
        }
      },
      "required": [
        "metric_id",
        "metric_digest",
        "manifest_digest",
        "parent_run_id",
        "schedule_receipt_ref",
        "state",
        "planned_rollout_count",
        "task_count",
        "rollouts_per_task",
        "observed_count",
        "zero_filled_count",
        "excluded_count",
        "missing_count",
        "invalid_count",
        "status_counts",
        "samples"
      ],
      "title": "MetricResult",
      "type": "object"
    },
    "MetricSample": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Attempt Id",
          "type": "string"
        },
        "attempt_index": {
          "minimum": 0,
          "title": "Attempt Index",
          "type": "integer"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Case Id",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/MetricSampleDisposition"
        },
        "evidence_bundle_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "trajectory_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "attempt_id",
        "case_id",
        "attempt_index",
        "status",
        "disposition"
      ],
      "title": "MetricSample",
      "type": "object"
    },
    "MetricSampleDisposition": {
      "enum": [
        "observed",
        "zero_filled",
        "excluded",
        "missing",
        "invalid"
      ],
      "title": "MetricSampleDisposition",
      "type": "string"
    },
    "RunStatus": {
      "description": "Closed outcome taxonomy retained for every planned rollout.",
      "enum": [
        "pass",
        "verified_fail",
        "scored",
        "no_output",
        "invalid_output",
        "timeout",
        "agent_error",
        "harness_fault",
        "verifier_error",
        "infra_error",
        "unsupported"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "StatisticalAnalysisReceipt": {
      "additionalProperties": false,
      "description": "Derived analysis values independently replayable from report lineage.",
      "properties": {
        "ci_method": {
          "const": "normal_approximation_v1",
          "title": "Ci Method",
          "type": "string"
        },
        "confidence_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Interval"
        },
        "confidence_level": {
          "exclusiveMaximum": 1.0,
          "exclusiveMinimum": 0.5,
          "title": "Confidence Level",
          "type": "number"
        },
        "effective_alpha": {
          "exclusiveMaximum": 0.5,
          "exclusiveMinimum": 0,
          "title": "Effective Alpha",
          "type": "number"
        },
        "family_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family Id"
        },
        "family_size": {
          "minimum": 1,
          "title": "Family Size",
          "type": "integer"
        },
        "format": {
          "const": "bmp-statistical-analysis-receipt-v1",
          "default": "bmp-statistical-analysis-receipt-v1",
          "title": "Format",
          "type": "string"
        },
        "holdout_split": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Holdout Split"
        },
        "holdout_verified": {
          "title": "Holdout Verified",
          "type": "boolean"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "multiple_comparison_method": {
          "enum": [
            "none",
            "bonferroni"
          ],
          "title": "Multiple Comparison Method",
          "type": "string"
        },
        "observed_min_repetitions": {
          "minimum": 1,
          "title": "Observed Min Repetitions",
          "type": "integer"
        },
        "observed_pair_count": {
          "minimum": 1,
          "title": "Observed Pair Count",
          "type": "integer"
        },
        "observed_unit_count": {
          "minimum": 1,
          "title": "Observed Unit Count",
          "type": "integer"
        },
        "paired_unit": {
          "items": {
            "type": "string"
          },
          "title": "Paired Unit",
          "type": "array"
        },
        "pairing_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pairing Digest",
          "type": "string"
        },
        "plan_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Digest",
          "type": "string"
        },
        "point_estimate": {
          "title": "Point Estimate",
          "type": "number"
        },
        "repetition_field": {
          "const": "repetition",
          "title": "Repetition Field",
          "type": "string"
        },
        "sample_variance": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Variance"
        },
        "standard_error": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Error"
        },
        "variance_method": {
          "const": "sample_variance_v1",
          "title": "Variance Method",
          "type": "string"
        }
      },
      "required": [
        "plan_digest",
        "metric",
        "paired_unit",
        "repetition_field",
        "observed_pair_count",
        "observed_unit_count",
        "observed_min_repetitions",
        "pairing_digest",
        "variance_method",
        "ci_method",
        "confidence_level",
        "effective_alpha",
        "point_estimate",
        "holdout_verified",
        "multiple_comparison_method",
        "family_size"
      ],
      "title": "StatisticalAnalysisReceipt",
      "type": "object"
    },
    "SubjectKind": {
      "description": "Execution/artifact shape that actually entered an execution path.\n\nThis is deliberately separate from :class:`ComparisonKind`: two subjects\nwith different runtime packaging (for example ``hcp_harness`` and\n``opaque_agent``) can both represent a complete Coding Agent.",
      "enum": [
        "hcp_harness",
        "opaque_agent",
        "evolver",
        "meta_evolver",
        "fake"
      ],
      "title": "SubjectKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "claim_eligible": {
            "const": false
          }
        }
      },
      "if": {
        "properties": {
          "gates": {
            "properties": {
              "execution_valid": {
                "properties": {
                  "valid": {
                    "const": true
                  }
                },
                "required": [
                  "valid"
                ]
              },
              "isolation_valid": {
                "properties": {
                  "valid": {
                    "const": true
                  }
                },
                "required": [
                  "valid"
                ]
              },
              "protocol_valid": {
                "properties": {
                  "valid": {
                    "const": true
                  }
                },
                "required": [
                  "valid"
                ]
              },
              "scoring_valid": {
                "properties": {
                  "valid": {
                    "const": true
                  }
                },
                "required": [
                  "valid"
                ]
              },
              "statistics_valid": {
                "properties": {
                  "valid": {
                    "const": true
                  }
                },
                "required": [
                  "valid"
                ]
              }
            },
            "required": [
              "execution_valid",
              "protocol_valid",
              "isolation_valid",
              "scoring_valid",
              "statistics_valid"
            ]
          }
        },
        "required": [
          "gates"
        ]
      },
      "then": {
        "properties": {
          "claim_eligible": {
            "const": true
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "effect_is_causal_claim": {
            "const": false
          }
        }
      },
      "if": {
        "properties": {
          "claim_eligible": {
            "const": true
          },
          "effect": {
            "type": "object"
          }
        },
        "required": [
          "claim_eligible",
          "effect"
        ]
      },
      "then": {
        "properties": {
          "effect_is_causal_claim": {
            "const": true
          }
        }
      }
    }
  ],
  "properties": {
    "claim_eligible": {
      "description": "Whether every independently recorded validity gate passes.",
      "readOnly": true,
      "title": "Claim Eligible",
      "type": "boolean"
    },
    "comparison_kind": {
      "$ref": "#/$defs/ComparisonKind"
    },
    "effect": {
      "anyOf": [
        {
          "$ref": "#/$defs/EffectEstimate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "effect_is_causal_claim": {
      "description": "Whether an estimate may be described using causal claim language.",
      "readOnly": true,
      "title": "Effect Is Causal Claim",
      "type": "boolean"
    },
    "experiment_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Experiment Id",
      "type": "string"
    },
    "failure_breakdown": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "#/$defs/RunStatus"
      },
      "title": "Failure Breakdown",
      "type": "object"
    },
    "gates": {
      "additionalProperties": {
        "$ref": "#/$defs/GateResult"
      },
      "maxProperties": 5,
      "minProperties": 5,
      "propertyNames": {
        "enum": [
          "execution_valid",
          "protocol_valid",
          "isolation_valid",
          "scoring_valid",
          "statistics_valid"
        ]
      },
      "title": "Gates",
      "type": "object"
    },
    "lineage": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LineageRef"
      },
      "title": "Lineage",
      "type": "array"
    },
    "manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "metric_results": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MetricResult"
      },
      "title": "Metric Results",
      "type": "array"
    },
    "purpose": {
      "const": "claim",
      "title": "Purpose",
      "type": "string"
    },
    "record_index_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "statistics_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatisticalAnalysisReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "subject_kinds": {
      "items": {
        "$ref": "#/$defs/SubjectKind"
      },
      "title": "Subject Kinds",
      "type": "array"
    }
  },
  "required": [
    "purpose",
    "comparison_kind",
    "subject_kinds",
    "experiment_id",
    "manifest_digest",
    "gates",
    "claim_eligible",
    "effect_is_causal_claim"
  ],
  "title": "ClaimReport",
  "type": "object"
}
