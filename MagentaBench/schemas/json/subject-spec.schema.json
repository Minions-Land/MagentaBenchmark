{
  "$defs": {
    "AssemblySubjectSpec": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Adapter",
          "type": "string"
        },
        "assembly_profile": {
          "default": "default",
          "minLength": 1,
          "title": "Assembly Profile",
          "type": "string"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "commit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "emits_trace": {
          "default": false,
          "title": "Emits Trace",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "hcp_harness",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "adapter",
        "source"
      ],
      "title": "AssemblySubjectSpec",
      "type": "object"
    },
    "EvolverSubjectSpec": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Adapter",
          "type": "string"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "commit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "emits_trace": {
          "default": false,
          "title": "Emits Trace",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "evolver",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "const": "harness",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "adapter",
        "source",
        "target"
      ],
      "title": "EvolverSubjectSpec",
      "type": "object"
    },
    "FakeSubjectSpec": {
      "additionalProperties": false,
      "description": "Deterministic subject reserved for protocol conformance tests.",
      "properties": {
        "adapter": {
          "const": "fake",
          "default": "fake",
          "title": "Adapter",
          "type": "string"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "fault_mode": {
          "default": "none",
          "enum": [
            "none",
            "no_output",
            "invalid_output",
            "timeout",
            "agent_error",
            "harness_fault",
            "verifier_error",
            "infra_error",
            "unsupported"
          ],
          "title": "Fault Mode",
          "type": "string"
        },
        "fixed_answer": {
          "default": "BMP_OK",
          "title": "Fixed Answer",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "fake",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "FakeSubjectSpec",
      "type": "object"
    },
