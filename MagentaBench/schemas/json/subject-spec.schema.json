        },
        "emits_trace": {
          "default": false,
          "title": "Emits Trace",
          "type": "boolean"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "meta_evolver",
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "const": "evolver",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "adapter",
        "source",
        "target"
