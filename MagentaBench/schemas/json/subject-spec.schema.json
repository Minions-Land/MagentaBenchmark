    "OpaqueAgentSubjectSpec": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Adapter",
          "type": "string"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "commit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Commit"
        },
        "emits_trace": {
          "default": false,
          "title": "Emits Trace",
          "type": "boolean"
        },
        "entrypoint": {
          "minLength": 1,
          "title": "Entrypoint",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "interface": {
          "minLength": 1,
          "title": "Interface",
          "type": "string"
        },
        "kind": {
          "const": "opaque_agent",
          "title": "Kind",
          "type": "string"
        },
        "launch_argv": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Launch Argv"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "adapter",
        "source",
        "entrypoint",
        "interface"
      ],
      "title": "OpaqueAgentSubjectSpec",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "evolver": "#/$defs/EvolverSubjectSpec",
      "fake": "#/$defs/FakeSubjectSpec",
      "hcp_harness": "#/$defs/AssemblySubjectSpec",
      "meta_evolver": "#/$defs/MetaEvolverSubjectSpec",
      "opaque_agent": "#/$defs/OpaqueAgentSubjectSpec"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/AssemblySubjectSpec"
    },
    {
      "$ref": "#/$defs/OpaqueAgentSubjectSpec"
    },
    {
      "$ref": "#/$defs/EvolverSubjectSpec"
    },
    {
      "$ref": "#/$defs/MetaEvolverSubjectSpec"
    },
    {
      "$ref": "#/$defs/FakeSubjectSpec"
    }
  ]
}
