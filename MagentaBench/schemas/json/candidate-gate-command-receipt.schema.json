{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Content-addressed reference to an artifact stored outside the manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "command_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Command Id",
      "type": "string"
    },
    "error_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "finished_at": {
      "title": "Finished At",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "timeout",
        "infra_error"
      ],
      "title": "Status",
      "type": "string"
    },
    "stderr_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "stdout_ref": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "command_id",
    "started_at",
    "finished_at",
    "status",
    "stdout_ref",
    "stderr_ref"
  ],
  "title": "CandidateGateCommandReceipt",
  "type": "object"
}
