{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Content-addressed reference to an artifact stored outside the manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Digest-bound dataset declaration carried by a resolved manifest.",
  "properties": {
    "adapter": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
      "title": "Adapter",
      "type": "string"
    },
    "artifact_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    },
    "bmp_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Bmp Version",
      "type": "string"
    },
    "commit": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commit"
    },
    "config": {
      "additionalProperties": true,
      "title": "Config",
      "type": "object"
    },
    "content_globs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Content Globs",
      "type": "array"
    },
    "declaration_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "format": {
      "default": "opaque",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Format",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "dataset",
      "title": "Kind",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "source_content_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Content Digest",
      "type": "string"
    },
    "split": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Split"
    }
  },
  "required": [
    "artifact_digest",
    "source",
    "source_content_digest",
    "id",
    "kind",
    "adapter",
    "declaration_ref",
    "content_globs"
  ],
  "title": "DatasetArtifact",
  "type": "object"
}
