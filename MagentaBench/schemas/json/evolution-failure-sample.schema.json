{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Content-addressed reference to an artifact stored outside the manifest.",
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One member of the complete population considered for diagnosis.\n\nSuccessful and failed members are retained together.  This keeps the\nfailure-sampling denominator auditable and prevents adapters from building\na convenient sample by silently dropping infrastructure failures.",
  "properties": {
    "candidate_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Candidate Id",
      "type": "string"
    },
    "eligible": {
      "title": "Eligible",
      "type": "boolean"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "included": {
      "title": "Included",
      "type": "boolean"
    },
    "inclusion_probability": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Inclusion Probability",
      "type": "number"
    },
    "item_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Item Id",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "success",
        "task_failure",
        "no_output",
        "invalid_output",
        "timeout",
        "agent_error",
        "harness_fault",
        "verifier_error",
        "infra_error",
        "unsupported"
      ],
      "title": "Outcome",
      "type": "string"
    }
  },
  "required": [
    "item_id",
    "candidate_id",
    "outcome",
    "eligible",
    "included",
    "inclusion_probability",
    "evidence_refs"
  ],
  "title": "EvolutionFailureSample",
  "type": "object"
}
