{
  "additionalProperties": false,
  "description": "TOML-registered dataset content and adapter configuration.",
  "properties": {
    "adapter": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
      "title": "Adapter",
      "type": "string"
    },
    "bmp_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Bmp Version",
      "type": "string"
    },
    "commit": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Commit"
    },
    "config": {
      "additionalProperties": true,
      "title": "Config",
      "type": "object"
    },
    "content_globs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Content Globs",
      "type": "array"
    },
    "format": {
      "default": "opaque",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Format",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "dataset",
      "title": "Kind",
      "type": "string"
    },
    "source": {
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "split": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Split"
    }
  },
  "required": [
    "id",
    "kind",
    "adapter",
    "source",
    "content_globs"
  ],
  "title": "DatasetSpec",
  "type": "object"
}
