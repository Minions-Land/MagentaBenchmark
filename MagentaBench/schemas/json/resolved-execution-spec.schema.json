{
  "$defs": {
    "BackendSpec": {
      "additionalProperties": false,
      "description": "Pinned execution backend registry entry.",
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Adapter",
          "type": "string"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "defaults": {
          "additionalProperties": true,
          "title": "Defaults",
          "type": "object"
        },
        "digest": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digest"
        },
        "environment": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnvironmentSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "executable": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executable"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "id",
        "kind",
        "adapter"
      ],
      "title": "BackendSpec",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "description": "Hard limits for a run; absent fields mean that limit is unspecified.",
      "properties": {
        "max_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_wall_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Seconds"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "CredentialRef": {
      "additionalProperties": false,
      "description": "Identity-bearing credential digest; secret values are never serialized.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "secret": {
          "const": true,
          "title": "Secret",
          "type": "boolean"
        },
        "source_file": {
          "minLength": 1,
          "title": "Source File",
          "type": "string"
        },
        "value_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value_sha256",
        "secret",
        "source_file"
      ],
      "title": "CredentialRef",
      "type": "object"
    },
    "EnvironmentSpec": {
      "additionalProperties": false,
      "description": "Reproducible environment requirements; interpreter pin is mandatory.",
      "properties": {
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "build_timeout_seconds": {
          "default": 600.0,
          "exclusiveMinimum": 0,
          "title": "Build Timeout Seconds",
          "type": "number"
        },
        "env_var_names": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Env Var Names",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "mounts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MountSpec"
          },
          "title": "Mounts",
          "type": "array"
        },
        "packages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Packages",
          "type": "array"
        },
        "python_version": {
          "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$",
          "title": "Python Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "python_version"
      ],
      "title": "EnvironmentSpec",
      "type": "object"
    },
    "MountSpec": {
      "additionalProperties": false,
      "description": "A content-addressed host-to-runtime mount declaration.",
      "properties": {
        "container_path": {
          "minLength": 1,
          "title": "Container Path",
          "type": "string"
        },
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "host_path": {
          "minLength": 1,
          "title": "Host Path",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "read_only": {
          "default": true,
          "title": "Read Only",
          "type": "boolean"
        }
      },
      "required": [
        "host_path",
        "name",
        "container_path"
      ],
      "title": "MountSpec",
      "type": "object"
    },
    "ProtocolSpec": {
      "additionalProperties": false,
      "description": "Execution schedule defaults resolved before local execution overrides.",
      "properties": {
        "adapter": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$",
          "title": "Adapter",
          "type": "string"
        },
        "adaptive_budget": {
          "default": false,
          "title": "Adaptive Budget",
          "type": "boolean"
        },
        "bmp_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Bmp Version",
          "type": "string"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate_selection": {
          "enum": [
            "single",
            "exact",
            "best_of_n"
          ],
          "title": "Candidate Selection",
          "type": "string"
        },
        "case_order": {
          "default": "fixed",
          "enum": [
            "fixed",
            "seeded_random",
            "random",
            "custom",
            "explicit"
          ],
          "title": "Case Order",
          "type": "string"
        },
        "checkpoint_policy": {
          "default": "disabled",
          "enum": [
            "disabled",
            "save",
            "resume",
            "save_and_resume"
          ],
          "title": "Checkpoint Policy",
          "type": "string"
        },
        "deterministic_conformance": {
          "default": false,
          "title": "Deterministic Conformance",
          "type": "boolean"
        },
        "explicit_case_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Explicit Case Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "test_time_scaling",
            "mechanism_validation",
            "benchmark_evaluation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parallelism": {
          "default": 1,
          "minimum": 1,
          "title": "Parallelism",
          "type": "integer"
        },
        "rollouts_per_case": {
          "default": 1,
          "minimum": 1,
          "title": "Rollouts Per Case",
          "type": "integer"
        },
        "state_reset": {
          "default": "per_case",
          "enum": [
            "per_case",
            "per_rollout",
            "never"
          ],
          "title": "State Reset",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "adapter",
        "candidate_selection"
      ],
      "title": "ProtocolSpec",
      "type": "object"
    },
    "ProviderBinding": {
      "additionalProperties": false,
      "description": "Resolved provider, transport, model, and credential identity.",
      "properties": {
        "base_url": {
          "minLength": 1,
          "title": "Base Url",
          "type": "string"
        },
        "credential_ref": {
          "$ref": "#/$defs/CredentialRef"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "provider_id": {
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
          "title": "Provider Id",
          "type": "string"
        },
        "wire_api": {
          "minLength": 1,
          "title": "Wire Api",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "base_url",
        "wire_api",
        "model_id",
        "credential_ref"
      ],
      "title": "ProviderBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Execution contract with registry references inlined.\n\nprovider_binding is optional only until the CLI-agent adapter resolves it;\na model-scope claim MUST compile-reject when provider_binding is None.",
  "properties": {
    "backend": {
      "$ref": "#/$defs/BackendSpec"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "protocol": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProtocolSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provider_binding": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    }
  },
  "required": [
    "backend",
    "model",
    "budget"
  ],
  "title": "ResolvedExecutionSpec",
  "type": "object"
}
