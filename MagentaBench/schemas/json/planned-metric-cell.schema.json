      "pattern": "^[0-9a-f]{64}$",
      "title": "Metric Digest",
      "type": "string"
    },
    "metric_id": {
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$",
