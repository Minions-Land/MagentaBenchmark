{
  "schema_version": "magentabench.memory-baseline-matrix.v1",
  "fairness_contract": {
    "held_fixed": [
      "base model and provider endpoint within each comparison block",
      "benchmark split and explicit case manifest",
      "system prompt and tool policy",
      "per-case token, cost, and wall-clock budgets",
      "seed, retry policy, state reset policy, and evaluator revision"
    ],
    "retry_policy": "No score-driven retry. Infrastructure retries create a new retained attempt.",
    "state_policy": "Use fresh state per method arm and per-rollout reset unless the preregistered method requires persistent state.",
    "result_policy": "Retain unsupported and blocked cells with reasons; never encode them as zero scores."
  },
  "benchmarks": [
    {
      "id": "locomo",
      "label": "LoCoMo",
      "registry_ids": ["locomo", "locomo.v1"],
      "data_status": "complete",
      "headline_metrics": ["f1", "bleu1", "llm_as_judge", "category_f1", "category_llm_as_judge"]
    },
    {
