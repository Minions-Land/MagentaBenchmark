{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Minions-Land/MagentaBenchmark/execution-profiles/schema.json",
  "additionalProperties": false,
  "properties": {
    "artifact_export_before_destroy": {
      "const": true
    },
    "credential_recording": {
      "const": "environment-names-only"
    },
    "evidence_ceiling": {
      "enum": [
        "exploratory",
        "bmp-gated"
      ]
    },
    "format": {
      "const": "magentabench-execution-profile-v1"
    },
    "isolation_boundary": {
      "enum": [
        "process",
        "task-container",
        "microvm"
      ]
    },
    "lab_issue": {
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
      "type": [
        "string",
        "null"
      ]
    },
    "mode": {
      "enum": [
        "local-process",
        "docker",
        "appcontainer",
        "e2b",
        "remote-sandbox"
      ]
    },
    "network_policy": {
      "enum": [
        "disabled",
        "benchmark-defined",
        "allowlist"
      ]
    },
    "network_observation_required": {
      "const": true
    },
    "registered_backend_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "required_identity_evidence": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "pattern": "^[^\\r\\n\\u0000]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "required_recovery_evidence": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "pattern": "^[^\\r\\n\\u0000]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "required_runtime_evidence": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "pattern": "^[^\\r\\n\\u0000]+$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "workspace_lifecycle": {
      "enum": [
        "ephemeral",
        "persist-on-failure"
      ]
    }
  },
  "required": [
    "format",
    "mode",
    "lab_issue",
    "registered_backend_ids",
    "isolation_boundary",
    "workspace_lifecycle",
    "network_policy",
    "credential_recording",
    "network_observation_required",
    "artifact_export_before_destroy",
    "required_identity_evidence",
    "required_runtime_evidence",
    "required_recovery_evidence",
    "evidence_ceiling"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "registered_backend_ids": {
            "maxItems": 0
          }
        },
        "required": [
          "registered_backend_ids"
        ]
      },
      "then": {
        "properties": {
          "evidence_ceiling": {
            "const": "exploratory"
          },
          "lab_issue": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_ceiling": {
            "const": "bmp-gated"
          }
        },
        "required": [
          "evidence_ceiling"
        ]
      },
      "then": {
        "properties": {
          "registered_backend_ids": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "type": "object"
}
